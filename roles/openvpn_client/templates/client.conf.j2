{{ ansible_managed | comment }}

client
tls-client
pull
dev tun
proto udp
remote {{ openvpn_client_server }} 1194 udp
resolv-retry infinite
nobind
dhcp-option DNS 9.9.9.9
user nobody
group {{ openvpn_group }}
persist-key
persist-tun
key-direction 1
tls-auth {{ openvpn_configuration_directory }}/ta.key 1
verb 3
ca {{ openvpn_configuration_directory }}/ca.crt
cert {{ openvpn_configuration_directory }}/client.crt
key {{ openvpn_configuration_directory }}/client.key
auth SHA512
