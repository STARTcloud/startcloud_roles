<?php

require_once('config.inc');

use OPNsense\AcmeClient\AcmeClient;
use OPNsense\Core\Config;

function find_node($list, string $name): array
{
    foreach ($list->iterateItems() as $uuid => $node) {
        if ((string)$node->name === $name) {
            return [(string)$uuid, $node];
        }
    }
    return ['', null];
}

function ensure_node($list, string $name, array $values, bool &$changed): string
{
    [$uuid, $node] = find_node($list, $name);
    if ($node === null) {
        $node = $list->Add();
        $node->name = $name;
        $node->id = uniqid('', true);
        $changed = true;
        [$uuid, $node] = find_node($list, $name);
    }
    foreach ($values as $key => $value) {
        if ((string)$node->$key !== (string)$value) {
            $node->$key = (string)$value;
            $changed = true;
        }
    }
    return $uuid;
}

$mode = $argv[1] ?? '';
$certificates = json_decode((string)getenv('SSL_ACME_CERTS'), true) ?: [];
$staging = getenv('SSL_ACME_STAGING') === '1';
$model = new AcmeClient();
$changed = false;
$result = ['changed' => false, 'certificates' => []];

if ($mode === 'configure') {
    foreach (['enabled' => '1', 'autoRenewal' => '1', 'environment' => $staging ? 'stg' : 'prod'] as $key => $value) {
        if ((string)$model->settings->$key !== $value) {
            $model->settings->$key = $value;
            $changed = true;
        }
    }
    ensure_node($model->accounts->account, 'letsencrypt', [
        'enabled' => '1',
        'email' => (string)getenv('SSL_ACME_EMAIL'),
        'ca' => $staging ? 'letsencrypt_test' : 'letsencrypt',
    ], $changed);
    ensure_node($model->validations->validation, 'cloudflare', [
        'enabled' => '1',
        'method' => 'dns01',
        'dns_service' => 'dns_cf',
        'dns_cf_token' => (string)getenv('SSL_CF_TOKEN'),
    ], $changed);
    ensure_node($model->actions->action, 'webgui', [
        'enabled' => '1',
        'type' => 'configd_restart_gui',
    ], $changed);
}

if ($mode === 'certificates') {
    [$account] = find_node($model->accounts->account, 'letsencrypt');
    [$validation] = find_node($model->validations->validation, 'cloudflare');
    [$action] = find_node($model->actions->action, 'webgui');
    foreach ($certificates as $certificate) {
        $domains = array_values((array)($certificate['domains'] ?? []));
        if (empty($domains)) {
            continue;
        }
        ensure_node($model->certificates->certificate, (string)$domains[0], [
            'enabled' => '1',
            'altNames' => implode(',', array_slice($domains, 1)),
            'account' => $account,
            'validationMethod' => $validation,
            'restartActions' => $action,
            'autoRenewal' => '1',
        ], $changed);
    }
}

if ($mode === 'configure' || $mode === 'certificates') {
    $messages = [];
    foreach ($model->performValidation() as $message) {
        $messages[] = $message->getField() . ': ' . $message->getMessage();
    }
    if (!empty($messages)) {
        fwrite(STDERR, implode("\n", $messages) . "\n");
        exit(1);
    }
    if ($changed) {
        $model->serializeToConfig();
        Config::getInstance()->save();
    }
}

foreach ($certificates as $certificate) {
    $domains = array_values((array)($certificate['domains'] ?? []));
    [$uuid, $node] = empty($domains) ? ['', null] : find_node($model->certificates->certificate, (string)$domains[0]);
    if ($node !== null) {
        $result['certificates'][] = [
            'name' => (string)$domains[0],
            'uuid' => $uuid,
            'issued' => (string)$node->certRefId !== '',
            'refid' => (string)$node->certRefId,
        ];
    }
}

if ($mode === 'webgui' && !empty($result['certificates']) && $result['certificates'][0]['refid'] !== '') {
    $config = Config::getInstance()->object();
    if ((string)$config->system->webgui->{'ssl-certref'} !== $result['certificates'][0]['refid']) {
        $config->system->webgui->{'ssl-certref'} = $result['certificates'][0]['refid'];
        Config::getInstance()->save();
        exec('/usr/local/sbin/configctl webgui restart');
        $changed = true;
    }
}

$result['changed'] = $changed;
echo json_encode($result), "\n";
