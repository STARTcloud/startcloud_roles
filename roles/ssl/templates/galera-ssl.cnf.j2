[mariadb]
ssl-cert = {{ ssl_push_galera_ssl_dir }}/fullchain.pem
ssl-key = {{ ssl_push_galera_ssl_dir }}/privkey.pem
ssl-ca = {{ ssl_push_galera_ssl_dir }}/chain.pem
tls_version = {{ ssl_push_galera_tls_version }}
{% if ssl_push_galera_require_secure_transport %}
require-secure-transport = on
{% endif %}
{% if ssl_push_galera_replication_tls %}
wsrep_provider_options = "socket.ssl=yes;socket.ssl_cert={{ ssl_push_galera_ssl_dir }}/fullchain.pem;socket.ssl_key={{ ssl_push_galera_ssl_dir }}/privkey.pem;socket.ssl_ca={{ ssl_push_galera_ssl_dir }}/chain.pem"
{% endif %}

[sst]
ssl-mode = {{ ssl_push_galera_sst_mode }}
tcert = {{ ssl_push_galera_ssl_dir }}/fullchain.pem
tkey = {{ ssl_push_galera_ssl_dir }}/privkey.pem
tca = {{ ssl_push_galera_sst_ca }}
