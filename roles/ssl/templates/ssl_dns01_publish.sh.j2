#!/bin/bash
set -e
lineage="$(basename "${RENEWED_LINEAGE}")"
case "${lineage}" in
{% for cert in ssl_dns01_certs %}
{% set lineage_name = cert.name | default(cert.domains | first) %}
  {{ lineage_name }})
    cp "${RENEWED_LINEAGE}/fullchain.pem" "{{ cert_dir }}/crt/{{ lineage_name }}.crt"
    cp "${RENEWED_LINEAGE}/privkey.pem" "{{ cert_dir }}/key/{{ lineage_name }}.key"
    cat "${RENEWED_LINEAGE}/fullchain.pem" "${RENEWED_LINEAGE}/privkey.pem" > "{{ cert_dir }}/combined/{{ lineage_name }}.pem"
    chown "{{ service_user }}:{{ service_group }}" "{{ cert_dir }}/crt/{{ lineage_name }}.crt" "{{ cert_dir }}/key/{{ lineage_name }}.key" "{{ cert_dir }}/combined/{{ lineage_name }}.pem"
    ;;
{% endfor %}
  *)
    exit 0
    ;;
esac
for hook in "{{ cert_dir }}/renewal-hooks.d"/*.sh; do
  [ -x "$hook" ] && "$hook"
done
exit 0
