#!/bin/bash
set -euo pipefail
python3 - "${CERTBOT_DOMAIN}" "${CERTBOT_VALIDATION}" <<'PYEOF'
import json
import sys
import urllib.request
domain, validation = sys.argv[1], sys.argv[2]
token = open('/etc/cloudflaredns/token').read().strip()
headers = {'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'}
labels = domain.split('.')
zone_id = None
for index in range(len(labels) - 1):
    name = '.'.join(labels[index:])
    request = urllib.request.Request('https://api.cloudflare.com/client/v4/zones?name=' + name, headers=headers)
    result = json.load(urllib.request.urlopen(request))['result']
    if result:
        zone_id = result[0]['id']
        break
if zone_id is None:
    sys.exit('No Cloudflare zone found for ' + domain)
body = json.dumps({'type': 'TXT', 'name': '_acme-challenge.' + domain, 'content': validation, 'ttl': 60}).encode()
request = urllib.request.Request('https://api.cloudflare.com/client/v4/zones/' + zone_id + '/dns_records', data=body, headers=headers, method='POST')
urllib.request.urlopen(request)
PYEOF
