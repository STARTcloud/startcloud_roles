template(name="RemoteHostFile" type="string" string="{{ syslog_receive_log_dir }}/%HOSTNAME%.log")
ruleset(name="remote") {
  action(type="omfile" dynaFile="RemoteHostFile")
}
{% if syslog_receive_udp | bool %}
module(load="imudp")
input(type="imudp" port="{{ syslog_receive_udp_port }}" ruleset="remote")
{% endif %}
{% if syslog_receive_tls | bool %}
global(DefaultNetstreamDriver="ossl" DefaultNetstreamDriverCertFile="{{ syslog_receive_tls_cert }}" DefaultNetstreamDriverKeyFile="{{ syslog_receive_tls_key }}")
{% endif %}
{% if syslog_receive_tcp | bool or syslog_receive_tls | bool %}
module(load="imtcp")
{% endif %}
{% if syslog_receive_tcp | bool %}
input(type="imtcp" port="{{ syslog_receive_tcp_port }}" ruleset="remote")
{% endif %}
{% if syslog_receive_tls | bool %}
input(type="imtcp" port="{{ syslog_receive_tls_port }}" ruleset="remote" StreamDriver.Name="ossl" StreamDriver.Mode="1" StreamDriver.AuthMode="anon")
{% endif %}
