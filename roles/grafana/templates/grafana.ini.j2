{{ ansible_managed | comment }}
# Grafana configuration rendered by the startcloud.startcloud_roles.grafana role.
# Only the keys set here override Grafana's shipped defaults.ini.

[server]
# Protocol Grafana serves with: http, https, h2 or socket.
protocol = {{ grafana_protocol }}
# Address Grafana binds to; empty binds every interface.
http_addr = {{ grafana_http_addr }}
http_port = {{ grafana_http_port }}
domain = {{ grafana_domain }}
# Read only when protocol is https or h2.
cert_file = {{ grafana_cert_file }}
cert_key = {{ grafana_cert_key }}
